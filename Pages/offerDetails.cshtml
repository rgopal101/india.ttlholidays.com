@page "{offer_name}"
@model india.ttlholidays.com.Pages.offerDetailsModel
@{
    ViewData["Title"] = Model.title;
}

<!-- Breadcrumb section Start-->
<div class="breadcrumb-section two">
    <div class="swiper home2-banner-slider">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="banner-bg"
                     style="background-image:linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url(@Model.imagePath);">
                </div>
            </div> 
        </div>
    </div>
    <div class="banner-content-wrap">
        <div class="container">
            <div class="banner-content"> 
                <h1>@Model.title</h1>
            </div>
        </div>
    </div> 
</div>
  
<div class="package-details-page pt-50 mb-30">
    <div class="container">
        <div class="row g-lg-4 gy-5 justify-content-between">
            <div class="col-xl-8 col-lg-8">
                <div class="package-details-warpper">
                    <div class="package-info-wrap mb-60">
                      
                        @if (!string.IsNullOrEmpty(@Model.imagePath))
                        {
                            <img src="@Model.imagePath" alt="Image" class="img-fluid" />
                        }
                        <h4 class="mt-5">@Model.title</h4>
                        <p>
                            @Model.shortDesc
                        </p>
                        <p>@Html.Raw(Model.description)</p>
                         
                    </div> 
                  
                </div>
            </div>
            <div class="col-lg-4  sticky-sidebar">

                <div class="package-details-sidebar">
                    <div class="pricing-and-booking-area mb-40">
