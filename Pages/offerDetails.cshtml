                                    </path>
                                </svg>
                            </span>
                        </button>
                        <span>
                            <svg width="14" height="14" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 0C3.13423 0 0 3.13423 0 7C0 10.8662 3.13423 14 7 14C10.8662 14 14 10.8666 14 7C14 3.13423 10.8662 0 7 0ZM7 12.6875C3.85877 12.6875 1.31252 10.1412 1.31252 7C1.31252 3.85877 3.85877 1.31252 7 1.31252C10.1412 1.31252 12.6875 3.85877 12.6875 7C12.6875 10.1412 10.1412 12.6875 7 12.6875ZM7.00044 3.06992C6.49908 3.06992 6.11973 3.33157 6.11973 3.75418V7.63042C6.11973 8.05347 6.49903 8.31423 7.00044 8.31423C7.48956 8.31423 7.88115 8.04256 7.88115 7.63042V3.75418C7.8811 3.3416 7.48956 3.06992 7.00044 3.06992ZM7.00044 9.1875C6.51875 9.1875 6.12673 9.57952 6.12673 10.0616C6.12673 10.5428 6.51875 10.9349 7.00044 10.9349C7.48212 10.9349 7.87371 10.5428 7.87371 10.0616C7.87366 9.57948 7.48212 9.1875 7.00044 9.1875Z" />
                            </svg>
                            Bonus Activity Included – Limited Time!
                        </span>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Package Details Page End-->
<!-- Relevant Package Section Start-->
<div class="relevant-package-section pt-50 mb-100">
    <div class="container">
        <div class="row justify-content-center mb-50">
            <div class="col-xl-6 col-lg-8">
                <div class="section-title text-center">
                    <h2>Other Offers</h2>
                    <p>Explore exclusive special offers and unbeatable deals on popular travel destinations.</p>
                </div>
            </div>
        </div>
        <div class="row mb-40">
            <div class="col-lg-12"> 

                 @if (Model.OffersRoot.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {
                    <div class="swiper home1-trip-slider">
                        <div class="swiper-wrapper">
                          @foreach (var offer in Model.OffersRoot.EnumerateObject())
                                {
                                    var offerData = offer.Value;
                                    var title = offerData.GetProperty("Title").GetString();
                                    var desc = offerData.GetProperty("shortDesc").GetString();
                                    var image = offerData.GetProperty("imagePath").GetString();
                        var url = offerData.GetProperty("Url").GetString();
                        <div class="swiper-slide">


                            <div class="tour-card"> 
                                <div class="tour-img-wrapper">
                                            <a asp-page="/offerDetails" asp-route-offer_name="@url" class="package-img">
                                    <img src="@($"{image}")" alt="" class="tour-img">
                                    </a>
                                </div> 
                                <div class="d-flex justify-content-between mt-2">
                                    
                                    <small class="rating"><i class="bi bi-star-fill"></i> 4.5 (24)</small>
                                </div> 
                                 
                                <div class="itinerary mt-2">
                                            <b>@title</b>
                                </div> 
                             
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn call-btn"><i class="bi bi-telephone-fill"></i></button>
                                    <button class="btn request-btn text-white fw-bold" data-bs-toggle="modal" onclick="GetpopData('@title','@image')" data-bs-target="#callbackModal">Request Callback</button>

                                </div> 
                            </div>  
                        </div>
                                } 

                        </div>
                    </div>
                        }
                        else
                        {
                            <p>No offers found.</p>
                        }


               
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12 d-flex justify-content-center">
                <div class="swiper-pagination2 paginations"></div>
            </div>
        </div>
    </div>
</div>

<script>

    function GetpopData(Name,image)
    {
        document.getElementById("tourThumb").src =image;
        document.getElementById("tourtitle").innerText =Name; 
    }
</script>
<div class="modal fade" id="callbackModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="width:100%;max-width:500px;">
        <div class="modal-content elegant-modal">
            <div class="modal-header p-3 border-0 align-items-start">
                <div class="d-flex align-items-start gap-3">
                    <img id="tourThumb" src="" class="tour-thumb">
                    <div>
                        <h4  id="tourtitle">
                            Northeastern Nirvana With Dirang Sightseeing Tour
                        </h4> 
                    </div>
                </div>
                <button type="button" class="close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <svg width="10" height="10" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.00247 0.500545C1.79016 0.505525 1.58918 0.582706 1.4362 0.735547L0.694403 1.479C0.345704 1.82743 0.389689 2.43243 0.79164 2.83493L3.00694 5.05341L0.79164 7.27092C0.389689 7.67328 0.345566 8.27842 0.694403 8.62753L1.4362 9.37044C1.7849 9.71872 2.38879 9.67543 2.7913 9.27293L5.00659 7.05473L7.22189 9.27293C7.62467 9.67543 8.22898 9.71872 8.57699 9.37044L9.31989 8.62753C9.6679 8.27856 9.62461 7.67342 9.22182 7.27092L7.00653 5.05341L9.22182 2.83493C9.62461 2.43243 9.6679 1.82743 9.31989 1.479L8.57699 0.735547C8.22898 0.386433 7.62467 0.430557 7.22189 0.833614L5.00659 3.05126L2.7913 0.833753C2.56515 0.606635 2.27482 0.493906 2.00247 0.500545Z" />
                    </svg>
                </button>

            </div>
            <div class="modal-body pt-0">

                <form class="row g-3">

                    <div class="col-12">
                        <input type="text" class="form-control elegant-field" placeholder="Full Name*">
                    </div>

                    <div class="col-12">
                        <input type="email" class="form-control elegant-field" placeholder="Email*">
                    </div>

                    <div class="col-12">
                        <input type="tel" class="form-control elegant-field" placeholder="Phone Number*">
                    </div>

                    <div class="col-md-6">
                        <input type="text" id="common_date" class="form-control elegant-field" placeholder="Travel Date*">
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control elegant-field" placeholder="No Of Travellers">
                    </div>

                    <div class="col-12">
                        <textarea class="form-control elegant-field" rows="3" placeholder="Message"></textarea>
                    </div>

                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0">
                <button class="btn submit-btn w-100 py-3">Connect With An Expert</button>
            </div>

        </div>
    </div>
</div>