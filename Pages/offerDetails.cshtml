                    <div class="row">
                        <div class="col-sm-12">
                            <div class="ofbg">
                                <p style="border-bottom: 1px solid #6C3; padding: 3px 0px 3px 0px;"><i class="fa fa-map-marker fa-2x" aria-hidden="true"><span style="color: #6C3;">Delhi</span></i></p>

                                <p class="ofb">Newyork to Delhi</p>
                                <p class="ofb">Atlanta to Delhi</p>
                                <p>Dallas to Delhi</p>
                                <p>&nbsp;</p>

                                <p style="border-bottom: 1px solid #6C3; padding: 3px 0px 3px 0px;"><i class="fa fa-map-marker fa-2x" aria-hidden="true"><span style="color: #6C3;">Mumbai</span></i></p>
                                <p class="ofb">Newyork to Mumbai</p>
                                <p class="ofb">Atlanta to Mumbai</p>
                                <p>Dallas to Mumbai</p>
                                <p>&nbsp;</p>

                                <p style="border-bottom: 1px solid #6C3; padding: 3px 0px 3px 0px;"><i class="fa fa-map-marker fa-2x" aria-hidden="true"><span style="color: #6C3;">Bangaluru</span></i></p>
                                <p class="ofb">Newyork to Bangaluru</p>
                                <p class="ofb">Atlanta to Bangaluru</p>
                                <p>Dallas to Mumbai</p>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <div class="pricing-and-booking-area mb-40">
                        <div class="batch">
                            <span>10% Off</span>
                        </div>
                       
