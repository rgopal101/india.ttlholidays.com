@page "{cityname}"
@model india.ttlholidays.com.Pages.packagesModel
@{
    ViewData["Title"] = @Model.pageTitle;
}
<div class="breadcrumb-section" style="background-image:linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url(@Model.bgimage);">
    <div class="container">
        <div class="banner-content">
            <h1>@Model.pageTitle</h1>
        </div>
    </div>
</div>

<div class="package-grid-page pt-50 mb-100">
    <div class="container">

        <div class="row">

            <div class="col-lg-12">
                <div class="section-title">
                    <h2>@Model.PackageCount</strong> Package Found for @Model.pageTitle</h2>
                </div>
            </div>

            <div class="col-lg-12">

                <div class="list-grid-product-wrap mt-5">
                    <div class="row gy-md-5 gy-4">

                        @if (Model.PackageRoot.ValueKind == System.Text.Json.JsonValueKind.Object)
                        {

                            @foreach (var package in Model.PackageRoot.EnumerateObject())
                            {
                                var PackageData = package.Value;
                                var Name = PackageData.GetProperty("packageName").GetString();
                                var Days = PackageData.GetProperty("days").GetString();
                                var Night = PackageData.GetProperty("night").GetString();
                                var image = PackageData.GetProperty("imagePath").GetString();
                                var url = PackageData.GetProperty("url").GetString();
                                var packagePrice = PackageData.GetProperty("packagePrice").GetString();
                                decimal packagePriceValue = 0; decimal saving = 0;
                                if (PackageData.TryGetProperty("packagePrice", out var priceProp))
                                {
                                    if (decimal.TryParse(priceProp.GetString(), out var basePrice))
                                    {
                                        packagePriceValue = basePrice + (basePrice * 0.10m); // +10%
                                        saving = packagePriceValue - basePrice;
                                    }
                                }
                                string? packageType = null;
                                if (PackageData.TryGetProperty("packageType", out var typeProp)) packageType = typeProp.GetString();



                                // var inclusion = PackageData.GetProperty("inclusion").GetString();
                                //var packageType = PackageData.GetProperty("packageType").GetString();

                                <div class="col-lg-4 col-md-6">

                                    <div class="tour-card">

                                <!-- Image -->
                                <div class="tour-img-wrapper">
                                            <a asp-page="/packageDetails" asp-route-pkg_name="@url" class="package-img">
                                    <img src="@($"{image}")" alt="" class="tour-img">
                                    </a>
                                </div>

                                <!-- Duration + Rating -->
                                <div class="d-flex justify-content-between mt-2">
                                    @if (!string.IsNullOrEmpty(Days) && !string.IsNullOrEmpty(Night))
                                    {
                                    <small class="text-muted"> @Days Days & @Night Nights</small> 
                                    }
                                    <small class="rating"><i class="bi bi-star-fill"></i> 4.5 (24)</small>
                                </div>

                                <!-- Title -->
                                <h5 class="mt-1 tour-title">@Name</h5>  
                                <div class="itinerary mt-2">
                                    <b>@Name</b> 
                                </div>
                                 
                                        <span class="price">INR @packagePrice <span class="text-muted">/Adult</span></span>
                                <span class="old-price">INR @packagePriceValue</span>
                                <span class="save-tag">SAVE INR @saving</span> 
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn call-btn"><i class="bi bi-telephone-fill"></i></button>
                                    <button class="btn request-btn text-white fw-bold" data-bs-toggle="modal" onclick="GetpopData('@Name',@packagePrice,@packagePriceValue,@saving,'@image')" data-bs-target="#callbackModal">Request Callback</button>
                                </div>

                            </div> 
                             
                                    
                                </div>



                            }

                        }
                        else
                        {
                            <p>No offers found.</p>
                        }

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
<script>

    function GetpopData(Name,packagePrice,packagePriceValue,saving,image)
    {
        document.getElementById("tourThumb").src =image;
        document.getElementById("tourtitle").innerText =Name;
        document.getElementById("packagePrice").innerText ='INR '+packagePrice;
        document.getElementById("packagePriceValue").innerText ='INR '+packagePriceValue;
        document.getElementById("saving").innerText ='INR '+saving;
    }
</script>
<div class="modal fade" id="callbackModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered" style="width:100%;max-width:500px;">
        <div class="modal-content elegant-modal">
            <div class="modal-header p-3 border-0 align-items-start">
                <div class="d-flex align-items-start gap-3">
                    <img id="tourThumb" src="" class="tour-thumb">
                    <div>
                        <h6 class="fw-bold mb-1 modal-tour-title" id="tourtitle">
                            Northeastern Nirvana With Dirang Sightseeing Tour
                        </h6>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="price-bold" id="packagePrice">INR 42,000</span>
                            <span class="price-old" id="packagePriceValue">INR 46,200</span>
                            <span class="save-badge" id="saving">SAVE INR 4,200</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <svg width="10" height="10" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.00247 0.500545C1.79016 0.505525 1.58918 0.582706 1.4362 0.735547L0.694403 1.479C0.345704 1.82743 0.389689 2.43243 0.79164 2.83493L3.00694 5.05341L0.79164 7.27092C0.389689 7.67328 0.345566 8.27842 0.694403 8.62753L1.4362 9.37044C1.7849 9.71872 2.38879 9.67543 2.7913 9.27293L5.00659 7.05473L7.22189 9.27293C7.62467 9.67543 8.22898 9.71872 8.57699 9.37044L9.31989 8.62753C9.6679 8.27856 9.62461 7.67342 9.22182 7.27092L7.00653 5.05341L9.22182 2.83493C9.62461 2.43243 9.6679 1.82743 9.31989 1.479L8.57699 0.735547C8.22898 0.386433 7.62467 0.430557 7.22189 0.833614L5.00659 3.05126L2.7913 0.833753C2.56515 0.606635 2.27482 0.493906 2.00247 0.500545Z" />
                    </svg>
                </button>

            </div>
            <div class="modal-body pt-0">

                <form class="row g-3">

                    <div class="col-12">
                        <input type="text" class="form-control elegant-field" placeholder="Full Name*">
                    </div>

                    <div class="col-12">
                        <input type="email" class="form-control elegant-field" placeholder="Email*">
                    </div>

                    <div class="col-12">
                        <input type="tel" class="form-control elegant-field" placeholder="Phone Number*">
                    </div>

                    <div class="col-md-6">
                        <input type="text" id="common_date" class="form-control elegant-field" placeholder="Travel Date*">
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control elegant-field" placeholder="No Of Travellers">
                    </div>

                    <div class="col-12">
                        <textarea class="form-control elegant-field" rows="3" placeholder="Message"></textarea>
                    </div>

                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0">
                <button class="btn submit-btn w-100 py-3">Connect With An Expert</button>
            </div>

        </div>
    </div>
</div>