                {
                    <div class="list-grid-product-wrap mt-5">
                        <div class="row gy-md-5 gy-4">
                            @foreach (var dest in Model.StudyVisaDestinations)
                            {

                                <div class="col-lg-3 col-md-6">
                                    <div class="package-card">
                                        <div class="package-img-wrap">
                                            <div class="swiper package-card-img-slider">
                                                <div class="swiper-wrapper">
                                                    <div class="swiper-slide">
                                                        <a asp-page="/VisaDetail" asp-route-country="@dest.Name" class="package-img">
                                                            <img src="@dest.ImageUrl" alt="@dest.Name" class="w-100" style="max-height:200px" />
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="slider-pagi-wrap">
                                                <div class="package-card-img-pagi paginations"></div>
                                            </div>
                                            <div class="batch">
                                                <span class="discount">"@dest.Name</span>
                                            </div>
                                        </div>
                                        <div class="package-content pb-0">
                                            <h5> <a asp-page="/VisaDetail" asp-route-country="@dest.Name">@dest.Name</a><small class="float-end text-primary">@dest.ProcessingDays Days</small></h5>

                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
