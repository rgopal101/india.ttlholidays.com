                                            <h5> <a asp-page="/VisaDetail" asp-route-country="@dest.Name">@dest.Name</a><small class="float-end text-primary" >@dest.ProcessingDays Days</small></h5>
                                            
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
