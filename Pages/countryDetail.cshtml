@foreach (var dest in Model.CountryDestinations)
{
    <div class="destination-box">

        <h2>@dest.Name</h2>

        <!-- Images -->
        <div class="image-gallery">
            @foreach (var img in dest.ImageUrls)
            {
                <img src="@img" alt="@dest.Name" width="200" />
            }
        </div>

        <!-- Description -->
       

        <!-- Itinerary -->
        <h4>Itinerary</h4>
        <ul>
            @foreach (var day in dest.Itinerary)
            {
                <li>@day</li>
            }
        </ul>

        <!-- What To Do -->
        <h4>What To Do</h4>
        <ul>
            @foreach (var todo in dest.WhatToDo)
            {
                <li>@todo</li>
            }
        </ul>

        <!-- Places -->
        <h4>Places to Visit</h4>
        <ul>
            @foreach (var place in dest.Places)
            {
                <li>@place</li>
            }
        </ul>

        <!-- Price -->
        <h4>Price</h4>
        <p>$@dest.Price</p>

        <!-- Inclusions -->
        <h4>Inclusions</h4>
        <ul>
            @foreach (var inc in dest.Inclusions)
            {
                <li>@inc</li>
            }
        </ul>

        <!-- Exclusions -->
        <h4>Exclusions</h4>
        <ul>
            @foreach (var exc in dest.Exclusions)
            {
                <li>@exc</li>
            }
        </ul>

        <hr />
    </div>
} 