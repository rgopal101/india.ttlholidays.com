<script>
$(document).ready(function() {
  // When the mouse enters the mega menu parent, open the mega menu.
  $('.main-menu .mega-menu').on('mouseenter', function() {
    $(this).find('.mega-menu-content').stop(true, true).slideDown(300);
  });
  
  // Remove the automatic closing on mouseleave.
  // If you want to close the mega menu only when a link is clicked:
  $('.main-menu .mega-menu-content a').on('click', function() {
    $(this).closest('.mega-menu-content').stop(true, true).slideUp(300);
  });
  
  // Optionally, if you want the menu to close when clicking outside of it:
  $(document).on('click', function(e) {
    if (!$(e.target).closest('.main-menu .mega-menu').length) {
      $('.main-menu .mega-menu-content').stop(true, true).slideUp(300);
    }
  });
  
  // Prevent clicks on the mega menu parent from propagating (if needed)
  $('.main-menu .mega-menu > a').on('click', function(e) {
    // Prevent the default behavior if needed
    e.preventDefault();
  });
});
</script>
<script>
$(document).ready(function(){
  // When a menu item is clicked, close any other open mega menus
  $('.main-menu .mega-menu > a').on('click', function(e) {
    e.preventDefault(); // Prevent the default link action
    
    // Close all other mega menus
    $('.main-menu .mega-menu-content').not($(this).siblings('.mega-menu-content')).slideUp(300);
    
    // Toggle the current mega menu content
    $(this).siblings('.mega-menu-content').slideToggle(300);
  });
  
  // Optional: Close the mega menu when clicking outside of it
  $(document).on('click', function(e) {
    if (!$(e.target).closest('.main-menu .mega-menu').length) {
      $('.main-menu .mega-menu-content').slideUp(300);
    }
  });
});
</script>

