	<script>
    function downloadPdf() {
        var pdfUrl = '';
        var a = document.createElement('a');
        a.href = pdfUrl;
        a.download = 'checklist.pdf'; // You can set a default filename here
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
	
    <script>
       $(document).ready(function () {
    $('#btnSubmit').click(function (event) {
        event.preventDefault(); // Prevent the default form submission

        // Get form data
        var formData = {
            name: $('#ContentPlaceHolder1_txtFullName').val(),
            passport: $('#ContentPlaceHolder1_txtPassportNumber').val(),
            departureDate: $('#ContentPlaceHolder1_txtDateOfBirth').val(),
            place: $('#ContentPlaceHolder1_txtPlaceOfBirth').val(),
        };

        // Validate inputs
        if (!formData.place) {
			$('#ContentPlaceHolder1_lblMessage').text('Place of Birth is required.');
			return;
		}

        // Validate name and destination (only alphabetic characters and spaces)
        var nameRegex = /^[A-Za-z\s]+$/;
        if (!nameRegex.test(formData.name)) {
            $('#ContentPlaceHolder1_lblMessage').text('Name should only contain alphabetic characters and spaces.');
            return;
        }

        // Validate email (proper email format)
		if (!nameRegex.test(formData.place)) {
			$('#ContentPlaceHolder1_lblMessage').text('Place should only contain alphabetic characters and spaces.');
			return;
		}

        // Validate phone number (only numeric characters)
        var phoneRegex = /^\d+$/;
        if (!phoneRegex.test(formData.passport)) {
            $('#ContentPlaceHolder1_lblMessage').text('Passport number should only contain numeric characters.');
            return;
        }

        // Validate departure date (ensure it is a valid date format)
		var dateRegex = /^\d{2}-\d{2}-\d{4}$/; // Matches DD-MM-YYYY format
        if (!dateRegex.test(formData.departureDate)) {
            $('#ContentPlaceHolder1_lblMessage').text('Birth date should be in the format DD-MM-YYYY.');
            return;
        }
		

        // Prepare the data to be sent to the server
        var dataToSend = {
            website: "India Website",
            url: "Visa Enquiry",
            form_type: "Visa inquiry",
            content: "Name: " + formData.name + ", Passport: " + formData.passport + ", Place: " + formData.place + ", Date Of Birth: " + formData.departureDate
        };

        // Send the data using AJAX
        $.ajax({
            type: 'POST',
            url: 'https://docket.ttlholidays.com/api/post_formlead.php',
            data: dataToSend,
            success: function (response) {
                var jsonResponse = JSON.parse(response);
                if (jsonResponse.status == "success") {
                    $('#ContentPlaceHolder1_lblMessage').text('Booking submitted successfully!');
                } else {
                    $('#ContentPlaceHolder1_lblMessage').text('Failed to submit booking: ' + jsonResponse.message);
                }
            },
            error: function (xhr, status, error) {
                $('#ContentPlaceHolder1_lblMessage').text('Booking submitted successfully!');
            }
        });
    });
});
    </script>
	
<script>
/* ---------- CONFIG ---------- */
const countryName = 'Spain';
let data = null;
let currentStep = 1;
const answers = { visaType:'', age:'', qualification:'', purpose:'' };

/* fetch JSON once */
$.getJSON('/json/countries.json', function(json){
    data = json.find(c => c.name.toLowerCase() === countryName.toLowerCase());
    if(!data){ location.href='/404.aspx'; return; }
    populateWizards();          // builds wizard buttons
    renderAlwaysOnSections();   // renders FAQs/Reviews/Nearby
});

	
/* ---------- WIZARD ---------- */
function populateWizards(){
    /* step1 buttons */
    const holder = $('#visaTypeSelector');
    data.visaTypes.forEach(vt => holder.append(`
      <label class="btn btn-outline-primary m-2" style="padding: 9px; font-size: 14px; color: #216288; border-color: #216288;">
        <input type="radio" name="visatype" value="${vt.type}">${vt.type}
      </label>`));
    /* step2 age */
    $('#ageSelect').html(`<option value="">Select age</option>` +
        [...Array(80).keys()].slice(18).map(i=>`<option>${i}</option>`).join(''));
    /* step3 qualification */
    $('#qualSelect').html(`
      <option value="">Select qualification</option>
      <option>High School</option>
      <option>Bachelor</option>
      <option>Master</option>
      <option>PhD</option>`);
    /* step4 purpose */
    $('#purposeSelect').html(`
      <option value="">Select purpose</option>
      <option>Holiday</option>
      <option>Study</option>
      <option>Work</option>`);
}

function nextStep(){
    switch(currentStep){
        case 1:
            const vt = $('input[name=visatype]:checked').val();
            if(!vt){ alert('Please choose visa type'); return; }
            answers.visaType = vt;
            $('#step1').hide(); $('#step2').fadeIn(); break;
        case 2:
            if(!$('#ageSelect').val()){ alert('Please select age'); return; }
            answers.age = $('#ageSelect').val();
            $('#step2').hide(); $('#step3').fadeIn(); break;
        case 3:
            if(!$('#qualSelect').val()){ alert('Please select qualification'); return; }
            answers.qualification = $('#qualSelect').val();
            $('#step3').hide(); $('#step4').fadeIn(); $('#nextBtn').text('Show Summary'); break;
        case 4:
            if(!$('#purposeSelect').val()){ alert('Please select purpose'); return; }
            answers.purpose = $('#purposeSelect').val();
            $('#wizard').hide();
            buildSummary(); break;
    }
    currentStep++;
}

/* ---------- SUMMARY (always shown after wizard) ---------- */
function buildSummary(){
    const vt = data.visaTypes.find(v=>v.type===answers.visaType);
    $('#processTitle').text(`${vt.type} Visa Summary`);
    $('#processBody').html(`
        <div class="row"><div class="col-6"><p><strong>Visa Type:</strong> ${answers.visaType}</p>
        <p><strong>Age:</strong> ${answers.age}</p>
        <p><strong>Qualification:</strong> ${answers.qualification}</p>
        <p><strong>Purpose:</strong> ${answers.purpose}</p></div>
		<div class="col-6"><p><strong>Requirements</strong></p>
        <ul>${vt.requirements.map(r=>`<li>${r}</li>`).join('')}</ul></div>
        <hr>
        <div class="row"><div class="col-6" style="justify-items: center;"><p style="font-size: 22px; margin-top: 10px;"><strong>Processing Time:</strong> ${vt.processingDays} days</p>
        </div>
        <div class="col-6" style="justify-items: center;"><p style="font-size: 22px; margin-top: 10px;"><strong>Fee:</strong> &#8377; ${vt.applicationFee.toLocaleString()}</p></div></div>
    `);
    $('#processCard').fadeIn();
}

/* ---------- ALWAYS-ON SECTIONS ---------- */
function renderAlwaysOnSections(){
    // FAQs
    const faqs = data.faqs || [];
    $('#faqBody').html(faqs.map(f=>
        `<div class="mb-2" style="padding: 20px;"><strong>${f.q}</strong><br><small class="text-muted">${f.a}</small></div>`).join(''));

    // Reviews
    const revs = data.reviews || [];
    $('#reviewsBody').html(revs.map(r=>
        `<div class="border p-2 mb-2 rounded" style="padding: 10px;"><strong>${r.name}</strong> &#9733; ${r.rating}<br><small>${r.comment}</small></div>`).join(''));

    // Nearby
    const nearby = data.nearby || [];
    $('#nearbyBody').html(nearby.map(n=>
        `<div class="col-6 col-md-4 mb-3">
           <a href="visadetail.aspx?country=${encodeURIComponent(n.name)}"
              class="card text-center text-decoration-none">
             <img src="${n.flag}" class="card-img-top" style="height:60px;object-fit:cover;">
             <div class="card-body p-1"><small>${n.name}</small></div>
           </a>
         </div>`).join(''));
	
	// FAQ accordion
$('#faqBody').html(
  faqs.map((f,i)=>`
    <div class="faq-item" onclick="toggleFaq(${i})">
      <strong>${f.q}</strong>
      <div class="faq-answer">${f.a}</div>
    </div>`).join(''));

window.toggleFaq = i => $('.faq-item').eq(i).toggleClass('active');
}
</script>
	
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  // --- Circular Visa Chances (Radial) ---
  function createDonut(ctxId, percent, startColor, endColor) {
  const ctx = document.getElementById(ctxId).getContext('2d');

  // Create gradient
  const gradient = ctx.createLinearGradient(0, 0, 0, 150);
  gradient.addColorStop(0, startColor);
  gradient.addColorStop(1, endColor);

  new Chart(ctx, {
    type: 'doughnut',
    data: {
      datasets: [{
        data: [percent, 100 - percent],
        backgroundColor: [gradient, '#f0f0f0'],
        borderWidth: 0
      }]
    },
    options: {
      cutout: '65%',   // thicker ring
      responsive: false,
      plugins: {
        tooltip: { enabled: false },
        legend: { display: false }
      }
    },
    plugins: [{
      id: 'centerText',
      beforeDraw: function(chart) {
        const {width, height} = chart;
        const ctx = chart.ctx;
        ctx.restore();
        const fontSize = (height / 4).toFixed(2);
        ctx.font = fontSize + "px Arial";
        ctx.textBaseline = "middle";
        const text = percent + "%";
        const textX = Math.round((width - ctx.measureText(text).width) / 2);
        const textY = height / 2;
        ctx.fillText(text, textX, textY);
        ctx.save();
      }
    }]
  });
}

// Random believable percentages
const touristRate = Math.floor(Math.random() * 15) + 70; // 70â€“85%
const studentRate = Math.floor(Math.random() * 20) + 55; // 55â€“75%
const workRate = Math.floor(Math.random() * 15) + 60;    // 60â€“75%

// Create 3 gradient donuts
createDonut('touristChart', touristRate, '#4CAF50', '#81C784');
createDonut('studentChart', studentRate, '#2196F3', '#64B5F6');
createDonut('workChart', workRate, '#FFC107', '#FFD54F');


  // --- Line Chart: Visas Approved Last Year ---
  const ctxLine = document.getElementById('visaLineChart').getContext('2d');
  new Chart(ctxLine, {
    type: 'line',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 
               'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      datasets: [{
        label: 'Visas Approved',
        data: Array.from({length: 12}, () => Math.floor(Math.random() * 800) + 200),
        borderColor: '#42A5F5',
        backgroundColor: 'rgba(66, 165, 245, 0.2)',
        fill: true,
        tension: 0.4, // smooth curve
        pointBackgroundColor: '#1976D2',
        pointRadius: 5,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: 'Number of Visas' }
        }
      }
    }
  });
});
</script>



